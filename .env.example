# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno del frontend.
#
#   cp .env.example .env.local
#
# El fichero real es .env.local y NUNCA se sube: está en .gitignore.
#
# ⚠️ Estas variables se resuelven AL COMPILAR, no en ejecución: si cambias una,
#    reinicia `npm run dev` o vuelve a hacer `npm run build`. En producción las
#    inyecta el workflow desde los secrets del repositorio.
# ─────────────────────────────────────────────────────────────────────────────


# ── URL del backend ──────────────────────────────────────────────── OBLIGATORIO
#
# Dos formas de trabajar:
#
#   a) Backend en local — lo normal si también tocas la API:
#        NEXT_PUBLIC_API_URL=http://localhost:3000
#      (levántalo con `npm run dev` en bootcamp-manager-server)
#
#   b) Backend ya desplegado — si solo tocas la interfaz y no quieres
#      levantar base de datos:
#        NEXT_PUBLIC_API_URL=https://bootcamp-manager-latest.onrender.com
#      Son DATOS REALES de producción: mira y prueba, pero lo que guardes
#      se guarda de verdad.
#
# En producción sale del secret BACKEND_URL del repositorio.
#
NEXT_PUBLIC_API_URL=http://localhost:3000


# ── Sub-ruta del sitio ────────────────────────────────────────────── opcional
#
# Solo hace falta cuando el sitio NO se sirve en la raíz del dominio.
# En GitHub Pages la URL es usuario.github.io/<repo>, así que en producción
# vale `/bootcamp-manager` — lo inyecta el workflow desde el secret BASE_PATH.
#
# En local déjalo vacío: `npm run dev` sirve en la raíz de localhost:5500 y
# ponerlo haría que todas las rutas dieran 404.
#
NEXT_PUBLIC_BASE_PATH=
